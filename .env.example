# Copy to .env and fill in. .env is git-ignored; never commit real values.

NODE_ENV=development

# Connection string used by the application and by sequelize-cli.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/educore

# HTTP port the API listens on. The frontend dev server expects 3000.
PORT=3000

# Signing secret for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
JWT_ACCESS_SECRET=replace-with-a-long-random-value

# Access token lifetime (jsonwebtoken format: 15m, 1h, 7d).
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime in days. Must match the refresh cookie Max-Age.
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Comma-separated list of origins allowed to make credentialed requests.
CORS_ORIGINS=http://localhost:3001

# Login throttling. Only failed attempts are counted.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Registration throttling. Counted on every attempt, since each one can create
# an account. An optional email prefix is also configurable per project.
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=60000

# Live tab sessions allowed per user. Each browser tab is its own session and
# its own cookie, so this bounds the cookie count. Signing in past the limit
# revokes the oldest sessions.
MAX_ACTIVE_SESSIONS_PER_USER=20

# Log every SQL statement. Off by default.
SQL_LOGGING=false

# Used only by `npm run seed:test-user`, which creates one local login for
# manual testing. No password is stored in source, so this must be set.
SEED_USER_PASSWORD=replace-with-a-local-dev-password
SEED_USER_EMAIL=aman@gmail.com

# Optional. The database the integration tests may create and drop. Its name
# must contain "test" or the test harness refuses to run. When unset, the
# harness derives <databaseName>_test_<pid> from DATABASE_URL.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/educore_test
